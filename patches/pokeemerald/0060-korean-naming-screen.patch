+// The KS index of the syllable (cho, jung, jong) of the Unicode composition
+// (indices 0-18, 0-20, 0-27), or -1 when KS X 1001 does not have it.
+static inline s16 HangulKsIndex(u8 cho, u8 jung, u8 jong)
+{
+    u16 target = (cho * 21 + jung) * 28 + jong;
+    s16 low = 0, high = ARRAY_COUNT(sHangulKsSyllables) - 1;
+
+    while (low <= high)
+    {
+        s16 mid = (low + high) / 2;
+
+        if (sHangulKsSyllables[mid] == target)
+            return mid;
+        if (sHangulKsSyllables[mid] < target)
+            low = mid + 1;
+        else
+            high = mid - 1;
+    }
+    return -1;
+}
