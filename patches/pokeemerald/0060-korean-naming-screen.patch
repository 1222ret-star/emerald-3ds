+#if KOREAN_INPUT
+static inline bool8 IsHangulLeadByte(u8 c)
+{
+    return (u8)(c - 0x37) <= 0x41 - 0x37;
+}
+
+// Initial consonant (0-18) -> final (1-27); 0: it cannot end a syllable.
+static const u8 sChoToJong[JAMO_CONSONANTS] = {1, 2, 4, 7, 0, 8, 16, 17, 0, 19, 20, 21, 22, 0, 23, 24, 25, 26, 27};
+
+// Final (1-27) -> initial consonant (0-18), for a single final.
+static const u8 sJongToCho[28] = {
+    JAMO_NONE, 0, 1, JAMO_NONE, 2, JAMO_NONE, JAMO_NONE, 3, 5, JAMO_NONE, JAMO_NONE, JAMO_NONE, JAMO_NONE,
+    JAMO_NONE, JAMO_NONE, JAMO_NONE, 6, 7, JAMO_NONE, 9, 10, 11, 12, 14, 15, 16, 17, 18,
+};
+
+// Double finals: {first final, added initial consonant, double final}.
+static const u8 sDoubleJong[][3] = {
+    {1, 9, 3}, {4, 12, 5}, {4, 18, 6}, {8, 0, 9}, {8, 6, 10}, {8, 7, 11}, {8, 9, 12},
+    {8, 16, 13}, {8, 17, 14}, {8, 18, 15}, {17, 9, 18},
+};
+
+// Double vowels: {first vowel, added vowel, double vowel} (0-20).
+static const u8 sDoubleJung[][3] = {
+    {8, 0, 9}, {8, 1, 10}, {8, 20, 11}, {13, 4, 14}, {13, 5, 15}, {13, 20, 16}, {18, 20, 19},
+};
+
+static u8 HangulTextLength(void)
+{
+    u8 i;
+
+    for (i = 0; i < sNamingScreen->template->maxChars; i++)
+    {
+        if (sNamingScreen->textBuffer[i] == EOS)
+            return i;
+    }
+    return sNamingScreen->template->maxChars;
+}
+
+// The characters in the text: the slots they take.
+static u8 HangulTextSlots(void)
+{
+    u8 i, slots = 0;
+
+    for (i = 0; i < sNamingScreen->template->maxChars && sNamingScreen->textBuffer[i] != EOS; i++, slots++)
+    {
+        if (IsHangulLeadByte(sNamingScreen->textBuffer[i]))
+            i++;
+    }
+    return slots;
+}
+
+static u8 DoubleJong(u8 jong, u8 cho)
+{
+    u8 i;
+
+    for (i = 0; i < ARRAY_COUNT(sDoubleJong); i++)
+    {
+        if (sDoubleJong[i][0] == jong && sDoubleJong[i][1] == cho)
+            return sDoubleJong[i][2];
+    }
+    return 0;
+}
+
+static u8 DoubleJung(u8 jung, u8 added)
+{
+    u8 i;
+
+    for (i = 0; i < ARRAY_COUNT(sDoubleJung); i++)
+    {
+        if (sDoubleJung[i][0] == jung && sDoubleJung[i][1] == added)
+            return sDoubleJung[i][2];
+    }
+    return JAMO_NONE;
+}
+
+static bool8 HangulExists(u8 cho, u8 jung, u8 jong)
+{
+    return HangulKsIndex(cho, jung, jong) >= 0;
+}
+
+// Writes the composition at index: the syllable, or the lone jamo.
+static void WriteHangul(u8 index, u8 cho, u8 jung, u8 jong)
+{
+    u8 *dest = &sNamingScreen->textBuffer[index];
+
+    if (cho != JAMO_NONE && jung != JAMO_NONE)
+    {
+        s16 ks = HangulKsIndex(cho, jung, jong);
+
+        dest[0] = 0x37 + ks / 239;
+        dest[1] = ks % 239 + 1;
+    }
+    else
+    {
+        dest[0] = 0x41;
+        dest[1] = cho != JAMO_NONE ? cho + 1 : JAMO_CONSONANTS + 1 + jung;
+    }
+}
+
+// Starts a new syllable at the end of the text; FALSE when it is full.
+static bool8 StartHangul(u8 cho, u8 jung)
+{
+    u8 length = HangulTextLength();
+
+    if (HangulTextSlots() >= ENTRY_SLOTS)
+        return FALSE;
+    sHangulAt = length;
+    sHangulCho = cho;
+    sHangulJung = jung;
+    sHangulJong = 0;
+    WriteHangul(length, cho, jung, 0);
+    return TRUE;
+}
+
+// The parts of a double final, or {jong, JAMO_NONE} for a single one.
+static void SplitJong(u8 jong, u8 *keep, u8 *moved)
+{
+    u8 i;
+
+    *keep = 0;
+    *moved = sJongToCho[jong];
+    for (i = 0; i < ARRAY_COUNT(sDoubleJong); i++)
+    {
+        if (sDoubleJong[i][2] == jong)
+        {
+            *keep = sDoubleJong[i][0];
+            *moved = sDoubleJong[i][1];
+        }
+    }
+}
+
+// Types jamo 1-40 (see sKeyboardChars) with the 2-beolsik rules.
+static void InputJamo(u8 jamo)
+{
+    bool8 composing = sHangulAt != NO_COMPOSITION;
+
+    if (jamo <= JAMO_CONSONANTS)
+    {
+        u8 cho = jamo - 1;
+
+        if (composing && sHangulCho != JAMO_NONE && sHangulJung != JAMO_NONE)
+        {
+            u8 jong = sHangulJong ? DoubleJong(sHangulJong, cho) : sChoToJong[cho];
+
+            if (jong && HangulExists(sHangulCho, sHangulJung, jong))
+            {
+                sHangulJong = jong;
+                WriteHangul(sHangulAt, sHangulCho, sHangulJung, jong);
+                return;
+            }
+        }
+        if (!StartHangul(cho, JAMO_NONE))
+            sHangulAt = NO_COMPOSITION;
+    }
+    else
+    {
+        u8 jung = jamo - JAMO_CONSONANTS - 1;
+
+        if (composing && sHangulJong)
+        {
+            // The final moves on to start the next syllable: 각 + ㅏ = 가가.
+            u8 keep, moved;
+
+            SplitJong(sHangulJong, &keep, &moved);
+            if (moved != JAMO_NONE && HangulExists(sHangulCho, sHangulJung, keep)
+             && HangulExists(moved, jung, 0)
+             && HangulTextSlots() < ENTRY_SLOTS)
+            {
+                WriteHangul(sHangulAt, sHangulCho, sHangulJung, keep);
+                StartHangul(moved, jung);
+                return;
+            }
+        }
+        else if (composing && sHangulJung == JAMO_NONE)
+        {
+            if (HangulExists(sHangulCho, jung, 0))
+            {
+                sHangulJung = jung;
+                WriteHangul(sHangulAt, sHangulCho, jung, 0);
+                return;
+            }
+        }
+        else if (composing)
+        {
+            u8 doubled = DoubleJung(sHangulJung, jung);
+
+            // Only on a consonant: the font has no lone double vowels.
+            if (doubled != JAMO_NONE && sHangulCho != JAMO_NONE && HangulExists(sHangulCho, doubled, 0))
+            {
+                sHangulJung = doubled;
+                WriteHangul(sHangulAt, sHangulCho, doubled, 0);
+                return;
+            }
+        }
+        if (!StartHangul(JAMO_NONE, jung))
+            sHangulAt = NO_COMPOSITION;
+    }
+}
+
+// Back: one jamo off the syllable being typed, else the last character.
+static void DeleteHangulOrCharacter(void)
+{
+    u8 length = HangulTextLength();
+    u8 i;
+
+    if (sHangulAt != NO_COMPOSITION && sHangulAt + 2 == length)
+    {
+        if (sHangulJong)
+        {
+            u8 keep, moved;
+
+            SplitJong(sHangulJong, &keep, &moved);
+            sHangulJong = keep;
+            WriteHangul(sHangulAt, sHangulCho, sHangulJung, keep);
+            return;
+        }
+        if (sHangulCho != JAMO_NONE && sHangulJung != JAMO_NONE)
+        {
+            u8 single = JAMO_NONE;
+
+            for (i = 0; i < ARRAY_COUNT(sDoubleJung); i++)
+            {
+                if (sDoubleJung[i][2] == sHangulJung)
+                    single = sDoubleJung[i][0];
+            }
+            sHangulJung = single;
+            WriteHangul(sHangulAt, sHangulCho, single, 0);
+            return;
+        }
+    }
+    sHangulAt = NO_COMPOSITION;
+    if (length == 0)
+        return;
+    if (length >= 2 && IsHangulLeadByte(sNamingScreen->textBuffer[length - 2]))
+        length--;
+    memset(&sNamingScreen->textBuffer[length - 1], EOS, sNamingScreen->template->maxChars - length + 1);
+}
+#endif
