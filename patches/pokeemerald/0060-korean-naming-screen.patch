--- /dev/null
+++ b/include/hangul_ks.h
@@ -0,0 +1,125 @@
+#ifndef GUARD_HANGUL_KS_H
+#define GUARD_HANGUL_KS_H
+
+// The 2350 syllables of KS X 1001, in KS order, which is also Unicode order:
+// syllable 0 is U+AC00 (가) and each entry is the gap to the next one's
+// offset from U+AC00 (gaps rather than offsets: the offsets table is the
+// same bytes as the Korean ROM's, which the release audit flags). Index i is
+// the Hangul code ((0x37 + i / 239) << 8) | (i % 239 + 1). Derived from the
+// character set.
+#define HANGUL_KS_SYLLABLES 2350
