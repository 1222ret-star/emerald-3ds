+
+static inline s32 HangulSyllableIndex(u8 lead, u8 trail)
+{
+    s32 index;
+
+    if (lead < HANGUL_LEAD_FIRST || lead >= HANGUL_LEAD_LAST || trail == 0 || trail > 0xEF)
+        return -1;
+    index = (lead - HANGUL_LEAD_FIRST) * 239 + trail - 1;
+    return index < HANGUL_SYLLABLES ? index : -1;
+}
+
+enum {
+    HANGUL_FINAL_NONE,
+    HANGUL_FINAL_OTHER,
+    HANGUL_FINAL_RIEUL,
+};
+
+// The final consonant of the syllable that ends at end[-1], if it is one.
+static inline u8 HangulFinalBefore(const u8 *end)
+{
+    s32 index = HangulSyllableIndex(end[-2], end[-1]);
+
+    if (index < 0 || !(sHangulHasFinal[index >> 3] & (1 << (index & 7))))
+        return HANGUL_FINAL_NONE;
+    if (sHangulFinalRieul[index >> 3] & (1 << (index & 7)))
+        return HANGUL_FINAL_RIEUL;
+    return HANGUL_FINAL_OTHER;
+}
+
+// Particles whose form depends on the final consonant before them.
+enum {
+    HANGUL_PARTICLE_TOPIC,      // 은/는
+    HANGUL_PARTICLE_SUBJECT,    // 이/가
+    HANGUL_PARTICLE_OBJECT,     // 을/를
+    HANGUL_PARTICLE_DIRECTION,  // 으(로)/(로): a final ㄹ takes 로
+    HANGUL_PARTICLE_COPULA,     // 이(다)/(다)
+    HANGUL_PARTICLE_AND,        // 과/와
+    HANGUL_PARTICLE_VOCATIVE,   // 아/야
+    HANGUL_PARTICLE_COUNT,
+};
+
+static inline const u8 *HangulParticle(u8 particle, u8 final)
+{
+    static const u8 sParticles[HANGUL_PARTICLE_COUNT][2][3] = {
+        [HANGUL_PARTICLE_TOPIC]     = {{0x38, 0xAB, EOS}, {0x3D, 0x60, EOS}}, // 는, 은
+        [HANGUL_PARTICLE_SUBJECT]   = {{0x37, 0x01, EOS}, {0x3D, 0x72, EOS}}, // 가, 이
+        [HANGUL_PARTICLE_OBJECT]    = {{0x3A, 0x29, EOS}, {0x3D, 0x61, EOS}}, // 를, 을
+        [HANGUL_PARTICLE_DIRECTION] = {{EOS},             {0x3D, 0x5E, EOS}}, // -, 으
+        [HANGUL_PARTICLE_COPULA]    = {{EOS},             {0x3D, 0x72, EOS}}, // -, 이
+        [HANGUL_PARTICLE_AND]       = {{0x3D, 0x15, EOS}, {0x37, 0x5A, EOS}}, // 와, 과
+        [HANGUL_PARTICLE_VOCATIVE]  = {{0x3C, 0xB8, EOS}, {0x3C, 0x9F, EOS}}, // 야, 아
+    };
+    bool8 withFinal = final != HANGUL_FINAL_NONE;
+
+    if (particle == HANGUL_PARTICLE_DIRECTION && final == HANGUL_FINAL_RIEUL)
+        withFinal = FALSE;
+    return sParticles[particle][withFinal];
+}
+
+#endif // GUARD_HANGUL_H
