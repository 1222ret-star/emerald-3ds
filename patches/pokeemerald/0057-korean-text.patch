+#if HANGUL_TEXT
+static void DecompressGlyph_Hangul(u16 glyphId, u8 face, u8 width, u8 height)
+{
+    const u16 *glyphs = Port_HangulGlyphs(face);
+
+    gCurGlyph.width = width;
+    gCurGlyph.height = height;
+    if (glyphs == NULL)
+    {
+        CpuFill32(0, gCurGlyph.gfxBufferTop, sizeof(gCurGlyph.gfxBufferTop));
+        CpuFill32(0, gCurGlyph.gfxBufferBottom, sizeof(gCurGlyph.gfxBufferBottom));
+        return;
+    }
+    glyphs += 0x20 * (glyphId - 0x3700);
+    if (width <= 8)
+    {
+        DecompressGlyphTile(glyphs, gCurGlyph.gfxBufferTop);
+        DecompressGlyphTile(glyphs + 0x10, gCurGlyph.gfxBufferBottom);
+    }
+    else
+    {
+        DecompressGlyphTile(glyphs, gCurGlyph.gfxBufferTop);
+        DecompressGlyphTile(glyphs + 0x8, gCurGlyph.gfxBufferTop + 8);
+        DecompressGlyphTile(glyphs + 0x10, gCurGlyph.gfxBufferBottom);
+        DecompressGlyphTile(glyphs + 0x18, gCurGlyph.gfxBufferBottom + 8);
+    }
+}
+
+// The glyph id of the character at *str, stepping over a Hangul trail byte.
+static u16 NextGlyphId(const u8 **str)
+{
+    u16 glyphId = **str;
+
+    if (IS_HANGUL_LEAD(glyphId) && (*str)[1] != EOS)
+        glyphId = (glyphId << 8) | *++*str;
+    return glyphId;
+}
+#endif
