+#if defined(PORT_BRIDGE) && GAME_LANGUAGE == LANGUAGE_KOREAN
+// Hangul is two bytes: a lead byte 0x37-0x41, then a trail byte 0x01-0xEF
+// (KS X 1001 order). A glyph id from 0x3700 up is a whole Hangul code.
+#define IS_HANGUL_LEAD(c) ((u8)((c) - 0x37) <= 0x41 - 0x37)
+#define IS_HANGUL_GLYPH(id) ((id) >= 0x3700 && (id) < 0x4200)
+static void DecompressGlyph_Hangul(u16 glyphId, u8 face, u8 width, u8 height);
+#define HANGUL_GLYPH(face, width, height)                         \
+    if (IS_HANGUL_GLYPH(glyphId))                                 \
+    {                                                             \
+        DecompressGlyph_Hangul(glyphId, face, width, height);     \
+        return;                                                   \
+    }
+#define HANGUL_GLYPH_WIDTH(width) if (IS_HANGUL_GLYPH(glyphId)) return width;
+#define HANGUL_TEXT 1
+#else
+#define HANGUL_GLYPH(face, width, height)
+#define HANGUL_GLYPH_WIDTH(width)
+#define HANGUL_TEXT 0
+#endif
