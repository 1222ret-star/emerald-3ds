Emerald 3DS changes to pret/pokeemerald 76463dac15cad36aca5e2b3f6366abf9e53f814f: Korean name lengths
Applies after 0058-korean-particles.patch; apply with tools/bootstrap.py.

Korean build only (GAME_LANGUAGE == LANGUAGE_KOREAN): item, move, trainer class
and Pokedex category names get the longer fields the Korean ROM gives them
(18, 16, 15 and 16 characters). Other languages keep the original sizes.

diff --git a/include/constants/global.h b/include/constants/global.h
index 2dff51e..d26ad00 100644
--- a/include/constants/global.h
+++ b/include/constants/global.h
@@ -91,13 +91,22 @@
 #define CONTEST_CATEGORIES_COUNT  5
 
 // string lengths
+#if GAME_LANGUAGE == LANGUAGE_KOREAN
+// The Korean names need the longer fields the Korean ROM gives them.
+#define ITEM_NAME_LENGTH 18
+#else
 #define ITEM_NAME_LENGTH 14
+#endif
 #define POKEMON_NAME_LENGTH 10
 #define POKEMON_NAME_BUFFER_SIZE max(20, POKEMON_NAME_LENGTH + 1) // Frequently used buffer size. Larger than necessary
 #define PLAYER_NAME_LENGTH 7
 #define MAIL_WORDS_COUNT 9
 #define EASY_CHAT_BATTLE_WORDS_COUNT 6
+#if GAME_LANGUAGE == LANGUAGE_KOREAN
+#define MOVE_NAME_LENGTH 16
+#else
 #define MOVE_NAME_LENGTH 12
+#endif
 #define NUM_QUESTIONNAIRE_WORDS 4
 #define QUIZ_QUESTION_LEN 9
 #define WONDER_CARD_TEXT_LENGTH 40
@@ -107,6 +116,13 @@
 #define TYPE_NAME_LENGTH 6
 #define ABILITY_NAME_LENGTH 12
 #define TRAINER_NAME_LENGTH 10
+#if GAME_LANGUAGE == LANGUAGE_KOREAN
+#define TRAINER_CLASS_NAME_LENGTH 15
+#define POKEDEX_CATEGORY_NAME_LENGTH 16
+#else
+#define TRAINER_CLASS_NAME_LENGTH 12
+#define POKEDEX_CATEGORY_NAME_LENGTH 12
+#endif
 
 #define MAX_STAMP_CARD_STAMPS 7
 
