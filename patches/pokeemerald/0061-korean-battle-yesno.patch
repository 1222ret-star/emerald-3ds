+        .width = 5,
+#else
         .tilemapLeft = 26,
         .tilemapTop = 9,
         .width = 3,
+#endif
         .height = 4,
         .paletteNum = 5,
         .baseBlock = 0x0100,
@@ -493,9 +499,15 @@ static const struct WindowTemplate sBattleArenaWindowTemplates[] =
     },
     [B_WIN_YESNO] = {
         .bg = 0,
+#if GAME_LANGUAGE == LANGUAGE_KOREAN
+        .tilemapLeft = 24,
+        .tilemapTop = 9,
+        .width = 5,
+#else
         .tilemapLeft = 26,
         .tilemapTop = 9,
         .width = 3,
+#endif
         .height = 4,
         .paletteNum = 5,
         .baseBlock = 0x0100,
diff --git a/src/battle_script_commands.c b/src/battle_script_commands.c
index 4ae4c71..1f85b59 100644
--- a/src/battle_script_commands.c
+++ b/src/battle_script_commands.c
@@ -10317,7 +10317,7 @@ void BattleCreateYesNoCursorAt(u8 cursorPosition)
     src[0] = 1;
     src[1] = 2;
 
-    CopyToBgTilemapBufferRect_ChangePalette(0, src, 0x19, 9 + (2 * cursorPosition), 1, 2, 0x11);
+    CopyToBgTilemapBufferRect_ChangePalette(0, src, YESNOBOX_CURSOR_X, 9 + (2 * cursorPosition), 1, 2, 0x11);
     CopyBgTilemapBufferToVram(0);
 }
 
@@ -10327,7 +10327,7 @@ void BattleDestroyYesNoCursorAt(u8 cursorPosition)
     src[0] = 0x1016;
     src[1] = 0x1016;
 
-    CopyToBgTilemapBufferRect_ChangePalette(0, src, 0x19, 9 + (2 * cursorPosition), 1, 2, 0x11);
+    CopyToBgTilemapBufferRect_ChangePalette(0, src, YESNOBOX_CURSOR_X, 9 + (2 * cursorPosition), 1, 2, 0x11);
     CopyBgTilemapBufferToVram(0);
 }
 
