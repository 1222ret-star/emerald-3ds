--- a/src/battle_bg.c
+++ b/src/battle_bg.c
@@ -272,9 +272,15 @@ static const struct WindowTemplate sStandardBattleWindowTemplates[] =
     },
     [B_WIN_YESNO] = {
         .bg = 0,
+#if GAME_LANGUAGE == LANGUAGE_KOREAN
+        .tilemapLeft = 24,
