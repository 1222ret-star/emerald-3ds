Emerald 3DS changes to pret/pokeemerald 76463dac15cad36aca5e2b3f6366abf9e53f814f: Korean UI layout
Applies after 0067-korean-battle-buffer-particles.patch; apply with tools/bootstrap.py.

Korean build only (GAME_LANGUAGE == LANGUAGE_KOREAN), as the Korean ROM lays it out:
FONT_SMALL_NARROW lines are 16 apart; the Bag's and the shop's item descriptions
start 8 pixels into their window; the party menu's action list is narrower,
against the right edge.

diff --git a/src/text.c b/src/text.c
--- a/src/text.c
+++ b/src/text.c
@@ -227,7 +227,12 @@
     [FONT_SMALL_NARROW] = {
         .fontFunction = FontFunc_SmallNarrow,
         .maxLetterWidth = 5,
+#if GAME_LANGUAGE == LANGUAGE_KOREAN
+        // As the Korean ROM: its 8x13 Hangul lines are 16 apart (Pokedex descriptions).
+        .maxLetterHeight = 16,
+#else
         .maxLetterHeight = 8,
+#endif
         .letterSpacing = 0,
         .lineSpacing = 0,
         .fgColor = 2,
diff --git a/src/item_menu.c b/src/item_menu.c
--- a/src/item_menu.c
+++ b/src/item_menu.c
@@ -2531,6 +2531,12 @@
 
 static void BagMenu_Print(u8 windowId, u8 fontId, const u8 *str, u8 left, u8 top, u8 letterSpacing, u8 lineSpacing, u8 speed, u8 colorIndex)
 {
+#if GAME_LANGUAGE == LANGUAGE_KOREAN
+    // Hangul glyphs have no left bearing: the description starts inside its box,
+    // where the Korean ROM's shop puts it (x 8).
+    if (windowId == WIN_DESCRIPTION && left == 3)
+        left = 8;
+#endif
     AddTextPrinterParameterized4(windowId, fontId, left, top, letterSpacing, lineSpacing, sFontColorTable[colorIndex], speed, str);
 }
 
diff --git a/src/shop.c b/src/shop.c
--- a/src/shop.c
+++ b/src/shop.c
@@ -663,7 +663,11 @@
     }
 
     FillWindowPixelBuffer(WIN_ITEM_DESCRIPTION, PIXEL_FILL(0));
+#if GAME_LANGUAGE == LANGUAGE_KOREAN
+    BuyMenuPrint(WIN_ITEM_DESCRIPTION, description, 8, 1, 0, COLORID_NORMAL); // as the Korean ROM
+#else
     BuyMenuPrint(WIN_ITEM_DESCRIPTION, description, 3, 1, 0, COLORID_NORMAL);
+#endif
 }
 
 static void BuyMenuPrintPriceInList(u8 windowId, u32 itemId, u8 y)
diff --git a/src/party_menu.c b/src/party_menu.c
